# ===== QuantLab OSS 环境变量示例 =====
# 复制为 backend/.env 后按需填写。全部可留空——留空时相关功能会「优雅降级」。

# LLM（AI 解读 / RD-Agent 提案翻译）。留空则 AI 相关接口返回提示而非报错。
QUANTLAB_LLM_API_KEY=
QUANTLAB_LLM_BASE_URL=https://api.deepseek.com
QUANTLAB_LLM_MODEL=deepseek-chat

# 行情库路径（默认 <repo>/data/market.db，由 examples/make_sample_data.py 生成）
MARKET_DB=

# 回测任务落盘目录（默认 <repo>/data/backtest；只保留最近 50 条，启动时自动清理）
BACKTEST_TASKS_DIR=

# Qlib 数据目录（留空则按 仓库内 qlib_data/ → ~/.qlib/qlib_data/cn_data 依次探测；
# 缺失时因子/回测页给出提示。由 `make qlib-sample` 生成仓库内数据集）
QLIB_DATA_DIR=

# ── RD-Agent 自动因子挖掘（可选，未配置则相关接口优雅报错）──
# rdagent 工作目录（含 .env / log/jobs / git_ignore_folder）
# 默认 <repo>/data/rdagent_demo —— 请尽量保持仓库内/独立目录，不要与其它项目共用
RDAGENT_HOME=
# conda 根目录（其下需有 envs/rdagent）
CONDA_ROOT=
# conda 环境名（默认取 <RDAGENT_HOME>/.env 里的 CONDA_ENV_NAME，再退化到 rdagent）
RDAGENT_CONDA_ENV=

# 服务端口
PORT=5001

# 公网演示模式（默认关闭）。设为 1 时：RD-Agent 只读化（历史/状态/结果可查看，
# 但禁止发起挖掘/清理，避免公开环境下被消耗付费 LLM 额度），并对训练/回测/筛选等
# 重接口按来源 IP 限流。本地开发无需设置。
OSS_DEMO=0

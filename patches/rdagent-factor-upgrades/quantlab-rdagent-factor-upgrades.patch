+            "raw_columns": [str(c) for c in out.columns if str(c) not in residual_set],
+            "against": {str(a["factor"]): [str(s) for s in a.get("against", [])] for a in applied},
+            "beta": {str(a["factor"]): a.get("beta") for a in applied},
+            "sota_n": int(sota_n or 0),
+            "sota_columns": [str(c) for c in list(out.columns)[: max(int(sota_n or 0), 0)]],
+            "config": {

+        min_abs_ic=float(getattr(setting, "factor_select_min_abs_ic", DEFAULT_MIN_ABS_IC)),
+        min_icir_tstat=float(
+            getattr(setting, "factor_select_min_icir_tstat", DEFAULT_MIN_ICIR_TSTAT)
+        ),
+        min_window=int(getattr(setting, "factor_select_min_window", DEFAULT_MIN_WINDOW)),
+        rank_by=_env_override(
+            "RDAGENT_FACTOR_RANK_BY", str(getattr(setting, "factor_select_rank_by", DEFAULT_RANK_BY))
+        ),
+        resid_tstat_min=_env_override(
+            "RDAGENT_FACTOR_RESID_TSTAT_MIN",
+            float(getattr(setting, "factor_select_resid_tstat_min", DEFAULT_RESID_TSTAT_MIN)),
+        ),
+        orthogonalize=_env_override(

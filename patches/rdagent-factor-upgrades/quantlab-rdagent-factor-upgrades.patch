+++ b/rdagent/scenarios/qlib/developer/factor_selector.py
@@ -0,0 +1,883 @@
+"""因子池重选 + 相关性剪枝 + 正交化（B4 / B5 / B6 / B7 / B8）
+
+背景（2026-09-19 定位到的设计缺陷）
+----------------------------------
+原 `QlibFactorRunner.develop` 直接拼历史全部因子 + 本轮新因子：
+
+    SOTA_factor  = process_factor_data(全部历史因子实验)   # 只增不减
+    combined     = pd.concat([SOTA_factor, new_factors], axis=1).dropna()
+
+后果：
+1. 因子池单调膨胀，早期弱因子永久占位 —— SOTA 组合第一轮就被锁死（实测 9/12~9/16
+   连续约 20 次运行 active_factors 一字未变），新因子只能「陪跑」无法替换；
+2. 同族因子（如 reversal_5d / reversal_5d_vol_scaled / reversal_5d_vol_scaled_20d）
+   高度相关却全部入池，组合上限被同族冗余占满，过拟合加重、Replace Best 更难通过。
+
+本模块在 concat 之后、写 `combined_factors_df.parquet` 之前插入一层**确定性**筛选：
+
+  B4 重选：对候选池按 |RankIC| 降序做贪心前向选择，至多保留 topk 个 → 弱因子被淘汰
+         （并设统计显著性门槛 |ICIR|·√days ≥ min_icir_tstat，杜绝噪声因子占位）
+  B5 剪枝：与已选因子横截面秩相关 > corr_max 的候选直接跳过 → 同族去冗余
+
+2026-09-24 扩展（小潘，依据 `QuantLab/data/rdagent/factor_redundancy_report.md` 的实证）
+--------------------------------------------------------------------------------------
+实证结论：近 10 轮 gate 全部不通过、且「Rank IC 略升但年化/Calmar 恶化」；原因不是
+「因子太多」，而是**判据看不出增量**：
+
+  * 少数因子对已有库高冗余：VW_DOWNSIDE_VOL_20D 对 DOWNSIDE_VOL_20D ρ=0.953/R²=0.927；
+    VW_MOMENTUM_20D 对 MOM_20D ρ=0.875；VW_REVERSAL_20D 对 MOM_20D ρ=0.868。
+  * **成对白跑**：VW_OVERNIGHT_MOMENTUM_20D × VW_OVERNIGHT_REVERSAL_20D 逐日截面
+    Spearman ρ = **-1.000**（同一因子取了负号）；MOMENTUM × REVERSAL ρ=-0.969。
+  * **原始 IC 与残差 IC 常反向**：VW_HIGH_LOW_RANGE_ASYM_RATIO_5D 原始 IC -0.0092 而残差
+    IC +0.0375（很有增量）；VW_MOMENTUM_20D 原始 IC -0.0516 而残差 IC +0.0038（≈纯冗余）。
+    ⇒ 用原始 IC 排序会**同时**放过高冗余的、砍掉正交的。
+
+因此新增：
+
+  B6 残差 IC 判据（`rank_by="resid_ic"`，**2026-09-25 起不再默认**）：候选对**已选集合**逐日
+     截面 z-score 后做 OLS 取残差，用残差算 Rank IC —— 只有「库里没有的信息」才算数；
+     并用残差 IC 的 t 统计量（`resid_tstat_min`）代替原始 ICIR 门槛。
+     实测翻车：真实候选都是同族变体 → 残差 t 极低 → 新因子全被否 → 池子冻结，故默认改回
+     `raw_ic`（见 DEFAULT_RANK_BY 处注释与 QuantLab/scripts/factor_select_smallpool_check.py）。
+  B7 判重/归一（`dedup`，默认开）：因子名归一化（`momentum`/`reversal` 视为同族、
+     `asymmetry_ratio`→`asymmetry`、剥离窗口后缀），同族且 |ρ| ≥ `dup_corr` 的候选判重，
+     只留残差 IC 高者，报告里标注 `duplicate_of` / `sign_flip_of`（ρ≈-1）。
+  B8 候选入库前正交化（`orthogonalize`，默认开）：新因子**对库**做截面正交化后再进组合，
+     从机制上消除「重复投票」（系数在抽样面板上估计，逐日截面 z-score ⇒ 只用当日信息，
+     无未来函数）。
+  B9 同族窗口上限（`family_window_max`，默认 2）：同一族最多保留 N 个窗口，避免
+     5/10/20/60D 同族堆叠（窗口间 ρ 实测 0.71~0.75）。
+
+2026-09-25 补丁（小潘）：B8 的**代价补偿**——正交化后写进 parquet 的是**残差**，
+因子值不再是「原义」（单因子可解释性、跨轮可比性、下游复用、归因都会受影响）。因此
+`select_combined_factors(workspace=...)` 在落盘时**额外**写两个文件（仅当本轮真的正交化过）：
+
+  * `combined_factors_raw.parquet`：选中列的**正交化前**原始值（同索引、同列序）
+    → 以后做因子解释/归因/给别的系统复用，用这份；
+  * `factor_ortho_manifest.json`：residual_columns / 对谁正交化 / β / 当时配置
+    → 复现「某轮某因子为什么是这个值」靠它（残差依赖当时的库，跨轮不可比）。
+
+特性：
+  - 确定性：同一池子 + 同一数据 ⇒ 同一结果（不引入随机性，可复现）
+  - 只用 train 段做选择（不碰 valid/test，避免挑优泄漏）
+  - 降级安全：任何异常一律回落原始因子集合（warning，不打断 loop）
+  - 耗时可控：相关性/正交化在**抽样面板**上计算（口径与 `_rank_corr` 一致，见 `max_rows`）
+
+数据来源：与因子代码**同源**的 `git_ignore_folder/factor_implementation_source_data/daily_pv.h5`
+（不依赖 qlib 运行时，避免 qlib 初始化/multiprocessing 的坑）。label 口径与回测配置一致：
+`Ref($close, -2)/Ref($close, -1) - 1`。
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import tables
+
+from rdagent.log import rdagent_logger as logger
+
+# ---------------------------------------------------------------------------
+# 默认口径（可被 FactorBasePropSetting 覆盖）
+# ---------------------------------------------------------------------------
+DEFAULT_ENABLE = True
+DEFAULT_TOPK = 10
+DEFAULT_CORR_MAX = 0.8
+DEFAULT_MIN_ABS_IC = 0.0
+DEFAULT_MIN_ICIR_TSTAT = 2.0
+DEFAULT_LABEL = "Ref($close,-2)/Ref($close,-1)-1"
+DEFAULT_CLOSE_COL = "$close"
+DEFAULT_MIN_WINDOW = 0  # 0 = 关闭兜底窗口过滤（见 conf.factor_select_min_window 注释）
+
+# —— 2026-09-24 新增（B6~B9）——
+# ⚠️ 2026-09-25：DEFAULT_RANK_BY 由 "resid_ic" 改回 "raw_ic"。
+#   原因：残差口径（resid_t≥2）在**真实挖掘**里把新因子全否了 —— 候选都是同族变体，
+#   去掉已有因子信息后残差≈0 → 残差 t 常年 0~1.7。实测：job 103550 全新会话 3 个候选
+#   只过 1 个；job 104411/105644 的 6 个新因子 0 通过（原始 t 高达 10.59/8.73/6.92 的
+#   强因子全被否）→ 池子冻结、Calmar 卡 0.21、Replace Best 永远 no。
+#   "raw_ic" 只改「排序/准入判据」（新因子回落用原始 |ICIR|·√days≥min_icir_tstat），
+#   相关性剪枝/同族上限/入库正交化（B7/B8/B9）全部照旧生效。
+#   复核：QuantLab/scripts/factor_select_smallpool_check.py（真实小池子三口径对比）
+DEFAULT_RANK_BY = "raw_ic"         # "raw_ic"（默认）| "resid_ic"（残差口径，暂不推荐）
+DEFAULT_RESID_TSTAT_MIN = 2.0      # 残差 IC 的 t 统计量门槛（**仅 rank_by=resid_ic 时生效**）
+DEFAULT_ORTHOGONALIZE = True       # 候选入库前对库正交化
+DEFAULT_FAMILY_WINDOW_MAX = 2      # 同族（名归一去窗口）最多保留的窗口数，0=关闭
+DEFAULT_DUP_CORR = 0.95            # 同族且 |ρ| ≥ 该值 → 判重，只留残差 IC 高者
+DEFAULT_ORTHO_MAX_ROWS = 200_000   # 正交化/相关矩阵的抽样上限（行；控制耗时）
+DEFAULT_RESID_PRESELECT = 40       # 残差 IC 贪心的候选上限（按原始 |IC| 预筛，控制耗时）
+
+# 因子名里的窗口写法：xxx_20d / xxx_5D / xxx_20day（只按名字判定，不读公式/描述）
+# 与 factor_proposal._WINDOW_IN_NAME 保持同一口径（(?![a-z0-9]) 容忍 `_20d_v2` 这种写法）
+_WINDOW_IN_NAME = re.compile(r"[_\-](\d{1,4})\s*(?:d(?:ays?)?)(?![a-z0-9])", re.IGNORECASE)
+
+# 归一同义词：把「同一个东西的不同写法」映射到同一族名（B7）
+_SYNONYMS = (
+    ("momentum", "momrev"),
+    ("reversal", "momrev"),
+    ("asymmetry_ratio", "asymmetry"),
+    ("high_low_range_asymmetry", "hl_range_asym"),
+    ("overnight_intraday_spread_asymmetry", "on_id_spread_asym"),
+    ("intraday", "id"),
+    ("overnight", "on"),
+    ("volume_weighted", "vw"),
+    ("vol_scaled", "vs"),
+    ("_ratio", ""),
+    ("_rank", ""),
+)
+
+
+def _window_from_name(name: str) -> int | None:
+    """从因子名里读出最小回看窗口（交易日）；读不到返回 None（调用方应放行）。"""
+    ws = [int(m) for m in _WINDOW_IN_NAME.findall(str(name or ""))]
+    return min(ws) if ws else None
+
+
+def canonical_name(name: str) -> str:
+    """因子名归一（B7）：剥窗口后缀 + 同义词折叠 → 同族因子得到同一个 key。
+
+    例：vw_momentum_20d / volume_weighted_reversal_5d → 同 key（momrev 族，符号相反）
+        vw_hl_range_asymmetry_ratio_20d / ..._asymmetry_20d → 同 key（命名漂移重复）
+    """
+    s = str(name or "").lower()
+    s = _WINDOW_IN_NAME.sub("", s)          # 剥窗口
+    s = re.sub(r"[^a-z0-9]+", "_", s).strip("_")
+    for a, b in _SYNONYMS:
+        s = s.replace(a, b)
+    s = re.sub(r"_{2,}", "_", s).strip("_")
+    return s
+
+
+# env 开关，临时关掉用 RDAGENT_FACTOR_SELECT=0
+_ENV_SWITCH = "RDAGENT_FACTOR_SELECT"
+
+_FALSEY = {"0", "false", "False", "no", "off", ""}
+
+# daily_pv.h5 候选路径（相对 cwd 或绝对）
+_SOURCE_CANDIDATES = [
+    "git_ignore_folder/factor_implementation_source_data/daily_pv.h5",
+    "git_ignore_folder/factor_implementation_source_data/daily_pv_all.h5",
+]
+
+
+# ---------------------------------------------------------------------------
+# 源数据：只取 $close 列 + (datetime, instrument) 索引
+# ---------------------------------------------------------------------------
+def _resolve_source_path(explicit: str | None = None) -> Path:
+    if explicit:
+        p = Path(os.path.expanduser(explicit))
+        if p.exists():
+            return p
+        raise FileNotFoundError(f"指定的 daily_pv 数据不存在：{p}")
+
+    env_p = os.environ.get("RDAGENT_DAILY_PV")
+    if env_p:
+        p = Path(os.path.expanduser(env_p))
+        if p.exists():
+            return p
+
+    bases = [Path.cwd()]
+    try:  # RD-Agent 的 workspace 根（git_ignore_folder 的父目录）
+        from rdagent.core.conf import RD_AGENT_SETTINGS
+
+        ws = Path(RD_AGENT_SETTINGS.workspace_path)
+        bases += [ws, ws.parent, ws.parent.parent]
+    except Exception:
+        pass
+
+    for b in bases:
+        for rel in _SOURCE_CANDIDATES:
+            p = (b / rel).resolve()
+            if p.exists():
+                return p
+    raise FileNotFoundError("找不到 daily_pv.h5（可通过 RDAGENT_DAILY_PV 指定）")
+
+
+def load_label(
+    *,
+    wanted_instruments: np.ndarray,
+    date_lo: pd.Timestamp,
+    date_hi: pd.Timestamp,
+    source_path: str | None = None,
+    close_col: str = DEFAULT_CLOSE_COL,
+) -> pd.Series:
+    """从 daily_pv.h5 取 $close，按 instrument 做 `Ref(-2)/Ref(-1)-1`，返回 label Series。
+
+    只读取需要的列与行窗口（date_hi 额外放宽 30 天，保证 train 末端 shift 合法）。
+    """
+    path = _resolve_source_path(source_path)
+    lo = np.datetime64(pd.Timestamp(date_lo))
+    hi = np.datetime64(pd.Timestamp(date_hi) + pd.Timedelta(days=30))
+
+    with tables.open_file(str(path), "r") as f:
+        node = f.get_node("/data")
+        items = [s.decode() if isinstance(s, bytes) else str(s) for s in node.block0_items[:]]
+        if close_col not in items:
+            raise KeyError(f"{path} 中无 {close_col} 列，实际列：{items}")
+        ci = items.index(close_col)
+
+        dates = pd.to_datetime(node.axis1_level0[:])  # level0 的取值（datetime）
+        dt_codes = node.axis1_label0[:]  # 行的 level0 编码
+        inst_names = np.array(
+            [s.decode() if isinstance(s, bytes) else str(s) for s in node.axis1_level1[:]]
+        )
+        inst_codes = node.axis1_label1[:]
+
+        row_dt = dates.values[dt_codes]  # 每行日期
+        di = np.where((row_dt >= lo) & (row_dt <= hi))[0]
+
+        # 只保留目标 instrument
+        keep = np.zeros(len(inst_names), dtype=bool)
+        keep[np.where(np.isin(inst_names, wanted_instruments))[0]] = True
+        di = di[keep[inst_codes[di]]]
+
+        if di.size == 0:
+            raise ValueError("daily_pv 中没有覆盖目标 instrument/日期窗口的数据")
+
+        # 读取 $close 整列后切片（fixed 格式无法按列读，单列 ~55MB 可接受）
+        close_col_vals = np.asarray(node.block0_values[:, ci], dtype=np.float64)
+        sub = pd.Series(
+            close_col_vals[di],
+            index=pd.MultiIndex.from_arrays(
+                [row_dt[di], inst_names[inst_codes[di]]], names=["datetime", "instrument"]
+            ),
+        )
+
+    sub = sub.sort_index()
+    g = sub.groupby(level="instrument")
+    label = g.shift(-2) / g.shift(-1) - 1.0
+    label.name = "label"
+    return label
+
+
+# ---------------------------------------------------------------------------
+# 指标
+# ---------------------------------------------------------------------------
+def daily_rank_ic(factor: pd.Series, label: pd.Series) -> pd.Series:
+    """日频横截面 Spearman（截面秩的 Pearson，向量化）。
+
+    返回按日期索引的 IC 序列。
+    """
+    df = pd.DataFrame({"f": factor, "l": label}).dropna()
+    if df.empty:
+        return pd.Series(dtype=float)
+
+    d = df.index.get_level_values("datetime")
+    df["f"] = df.groupby(d)["f"].rank(pct=True)
+    df["l"] = df.groupby(d)["l"].rank(pct=True)
+
+    mean = df.groupby(d)[["f", "l"]].transform("mean")
+    a = df["f"] - mean["f"]
+    b = df["l"] - mean["l"]
+
+    num = (a * b).groupby(d).sum()
+    den = np.sqrt((a * a).groupby(d).sum() * (b * b).groupby(d).sum())
+    ic = (num / den).replace([np.inf, -np.inf], np.nan).dropna()
+    return ic.astype(float)
+
+
+def _sample_panel(df: pd.DataFrame, max_rows: int = DEFAULT_ORTHO_MAX_ROWS) -> pd.DataFrame:
+    """按整日抽样把面板压到 max_rows 行内（与 _rank_corr 同一口径，保证耗时可控）。"""
+    n_rows = len(df)
+    if n_rows <= max_rows or n_rows == 0:
+        return df
+    dates = df.index.get_level_values("datetime").unique()
+    k = max(1, int(np.ceil(n_rows / max_rows)))
+    keep = dates[::k]
+    mask = np.isin(df.index.get_level_values("datetime").values, keep.values)
+    return df.loc[mask]
+
+
+def _zscore_by_day(df: pd.DataFrame) -> pd.DataFrame:
+    """逐日截面 z-score（截面标准化）。逐日 demean ⇒ 后续 OLS 无需截距项。"""
+    g = df.groupby(level="datetime")
+    mu = g.transform("mean")
+    sd = g.transform("std")
+    sd = sd.replace(0.0, np.nan)
+    return (df - mu) / sd
+
+
+def _fit_beta(Z: pd.DataFrame, cand: str, sels: list[str]) -> np.ndarray | None:
+    """抽样面板上拟合 cand ~ sum(sels)（列已逐日 z-score，故无截距）。
+
+    返回系数向量（长度 = len(sels)）；样本不足返回 None。
+    """
+    if not sels:
+        return np.zeros(0, dtype=np.float64)
+    X = Z[sels].to_numpy(dtype=np.float64)
+    y = Z[cand].to_numpy(dtype=np.float64)
+    m = np.isfinite(X).all(axis=1) & np.isfinite(y)
+    if m.sum() < 50:
+        return None
+    A = X[m]
+    b = y[m]
+    try:
+        beta, *_ = np.linalg.lstsq(A, b, rcond=None)
+    except np.linalg.LinAlgError:
+        return None
+    return beta
+
+
+def _resid_series(Z: pd.DataFrame, cand: str, sels: list[str]) -> pd.Series:
+    """在抽样面板上返回候选因子对已选集合的残差序列（列已逐日 z-score）。"""
+    if not sels:
+        return Z[cand]
+    beta = _fit_beta(Z, cand, sels)
+    if beta is None:
+        return Z[cand] * np.nan
+    X = Z[sels].to_numpy(dtype=np.float64)
+    r = Z[cand].to_numpy(dtype=np.float64) - X @ beta
+    return pd.Series(r, index=Z.index, name=cand)
+
+
+def _rank_corr(ranks: pd.DataFrame, max_rows: int = 400_000) -> pd.DataFrame:
+    """横截面秩相关矩阵（Spearman）。行数过多时按整日抽样，保证耗时可控。"""
+    n_rows = len(ranks)
+    if n_rows > max_rows:
+        dates = ranks.index.get_level_values("datetime").unique()
+        k = max(1, int(np.ceil(n_rows / max_rows)))
+        keep_dates = dates[::k]
+        ranks = ranks.loc[np.isin(ranks.index.get_level_values("datetime").values, keep_dates.values)]
+    return ranks.corr(method="pearson")
+
+
+# ---------------------------------------------------------------------------
+# 主流程
+# ---------------------------------------------------------------------------
+def select_factors(
+    pool: pd.DataFrame,
+    *,
+    train_start: str,
+    train_end: str,
+    topk: int = DEFAULT_TOPK,
+    corr_max: float = DEFAULT_CORR_MAX,
+    min_abs_ic: float = DEFAULT_MIN_ABS_IC,
+    min_icir_tstat: float = DEFAULT_MIN_ICIR_TSTAT,
+    min_window: int = DEFAULT_MIN_WINDOW,
+    rank_by: str = DEFAULT_RANK_BY,
+    resid_tstat_min: float = DEFAULT_RESID_TSTAT_MIN,
+    orthogonalize: bool = DEFAULT_ORTHOGONALIZE,
+    family_window_max: int = DEFAULT_FAMILY_WINDOW_MAX,
+    dup_corr: float = DEFAULT_DUP_CORR,
+    sota_n: int = 0,
+    source_path: str | None = None,
+    close_col: str = DEFAULT_CLOSE_COL,
+) -> tuple[pd.DataFrame, dict]:
+    """贪心前向选择 → (选中子集, 报告)。
+
+    B6：`rank_by="resid_ic"`（**2026-09-25 起非默认**）时按**残差 IC**（对已选集合正交化后的 IC）
+        降序选择，并用 `resid_tstat_min` 做显著性门槛；`rank_by="raw_ic"`（默认）按原始 IC 排序，
+        新的显著性门槛回落为原始 |ICIR|·√days≥min_icir_tstat（= 09-19 稳定口径）。
+    B7：`dup_corr` 把「同族 + 高相关」判重（ρ≈-1 记为 sign_flip_of）。
+    B8：`orthogonalize=True` 时，**新因子**（不在 SOTA 库里的）在写入前对库做截面正交化。
+    B9：`family_window_max` 限制同族窗口数（0=关闭）。
+    """
+    # 入参由 concat(SOTA_factor, new_factors) 而来，可能含重名列；先按 runner 同口径去重（keep=last）
+    pool = pool.loc[:, ~pool.columns.duplicated(keep="last")]
+    cols = list(pool.columns)
+    report: dict = {
+        "pool": [str(c) for c in cols],
+        "selected": [str(c) for c in cols],
+        "dropped": {},
+        "metrics": {},
+        "topk": topk,
+        "corr_max": corr_max,
+        "min_abs_ic": min_abs_ic,
+        "min_icir_tstat": min_icir_tstat,
+        "min_window": min_window,
+        "rank_by": rank_by,
+        "resid_tstat_min": resid_tstat_min,
+        "orthogonalize": orthogonalize,
+        "family_window_max": family_window_max,
+        "dup_corr": dup_corr,
+        "train_window": [str(train_start), str(train_end)],
+    }
+    if len(cols) <= 1:
+        return pool, report
+
+    pool = pool.sort_index()
+    insts = pool.index.get_level_values("instrument").unique().to_numpy()
+    label = load_label(
+        wanted_instruments=insts,
+        date_lo=pd.Timestamp(train_start),
+        date_hi=pd.Timestamp(train_end),
+        source_path=source_path,
+        close_col=close_col,
+    )
+
+    # 只用 train 段
+    dt = pool.index.get_level_values("datetime")
+    m_train = (dt >= pd.Timestamp(train_start)) & (dt <= pd.Timestamp(train_end))
+    p = pool.loc[m_train]
+    y = label.reindex(p.index)
+    if p.empty:
+        raise ValueError("train 段内无因子数据")
+
+    # 1) 单因子 |RankIC| / ICIR（原始判据，保留以便对比与门槛）
+    metrics: dict = {}
+    for c in cols:
+        ic = daily_rank_ic(p[c], y)
+        if len(ic) == 0:
+            metrics[str(c)] = {"rank_ic": 0.0, "icir": 0.0, "days": 0}
+            continue
+        m = float(ic.mean())
+        s = float(ic.std(ddof=1)) if len(ic) > 1 else 0.0
+        icir = m / s if s > 0 else 0.0
+        metrics[str(c)] = {
+            "rank_ic": round(m, 6),
+            "icir": round(icir, 4),
+            "tstat": round(abs(icir) * np.sqrt(len(ic)), 2),
+            "days": int(len(ic)),
+        }
+    report["metrics"] = metrics
+
+    # 2) 秩相关矩阵（B5/B7 用）
+    ranks = p.groupby(level="datetime").rank(pct=True)
+    corr = _rank_corr(ranks, max_rows=DEFAULT_ORTHO_MAX_ROWS)
+
+    # 2b) 抽样面板（B6/B8 用；逐日 z-score 后 OLS 无截距）
+    ps = _sample_panel(p)
+    ys = y.reindex(ps.index)
+    Z = _zscore_by_day(ps)
+    report["ortho_panel"] = {"rows": int(len(ps)), "dates": int(ps.index.get_level_values("datetime").nunique())}
+
+    # 2c) 同族窗口计数用（B9）
+    canon = {c: canonical_name(c) for c in cols}
+
+    # 3) 贪心前向选择
+    selected: list = []
+    dropped: dict = {}
+    resid_cache: dict[tuple, dict] = {}
+
+    def _resid_metrics(c: str) -> dict:
+        """对当前已选集合算残差 IC / t（结果缓存，避免重复回归）。"""
+        key = (c, tuple(selected))
+        if key in resid_cache:
+            return resid_cache[key]
+        r = _resid_series(Z, c, selected)
+        ic = daily_rank_ic(r.astype(float), ys)
+        if len(ic) == 0:
+            out = {"resid_ic": 0.0, "resid_tstat": 0.0, "resid_days": 0}
+        else:
+            m = float(ic.mean())
+            s = float(ic.std(ddof=1)) if len(ic) > 1 else 0.0
+            icir = m / s if s > 0 else 0.0
+            out = {
+                "resid_ic": round(m, 6),
+                "resid_icir": round(icir, 4),
+                "resid_tstat": round(abs(icir) * np.sqrt(len(ic)), 2),
+                "resid_days": int(len(ic)),
+            }
+        resid_cache[key] = out
+        return out
+
+    # 3b) 两阶段选择：
+    #   阶段 A（种子）—— **库成员**（前 sota_n 列）只做「相关性去冗余 + 原始显著性门槛」，
+    #     不让一波相关的新因子把基线整体掀掉（离线 A/B 实测：不区分时 9 个库成员会被全淘汰，
+    #     组合反而变窄 → ReplaceBest 更难通过）。库内既有的弱/冗余因子仍可被淘汰（保留 B4/B5 初衷）。
+    #   阶段 B（增量）—— **新因子**按残差 IC（对已选集合正交化）贪心入选，走 B6~B9 全部门槛。
+    library = [str(c) for c in cols[: max(int(sota_n), 0)]]
+    cand_pool = [c for c in cols if c not in set(library)]
+    if rank_by == "resid_ic":
+        cap = max(DEFAULT_RESID_PRESELECT, topk)
+        ranked_cand = sorted(
+            cand_pool, key=lambda c: (-abs(metrics[str(c)]["rank_ic"]), -abs(metrics[str(c)]["icir"]))
+        )
+        keep_cand = set(ranked_cand[:cap])
+        for c in cand_pool:
+            if c not in keep_cand:
+                dropped[str(c)] = "resid_preselect(原始|IC|排名靠后)"
+        cand_pool = [c for c in ranked_cand if c in keep_cand]
+    report["library"] = library
+    report["candidates"] = [str(c) for c in cand_pool]
+
+    # —— 阶段 A：库成员（按原始 |RankIC| 降序做去冗余，最强代表优先占据相关簇）——
+    for c in sorted(library, key=lambda x: (-abs(metrics[str(x)]["rank_ic"]), -abs(metrics[str(x)]["icir"]))):
+        if len(selected) >= max(topk, 1):
+            dropped[str(c)] = "topk_exceeded"
+            continue
+        w = _window_from_name(str(c))
+        if min_window > 0 and w is not None and w < min_window:
+            dropped[str(c)] = f"window<{min_window}d (={w}d)"
+            continue
+        mm = metrics[str(c)]
+        if min_icir_tstat > 0 and mm["tstat"] < min_icir_tstat:
+            dropped[str(c)] = f"|ICIR|·√days<{min_icir_tstat} (t={mm['tstat']})"
+            continue
+        if min_abs_ic > 0 and abs(mm["rank_ic"]) < min_abs_ic:
+            dropped[str(c)] = f"|RankIC|<{min_abs_ic} (={mm['rank_ic']:+.4f})"
+            continue
+        if selected:
+            rho = corr.loc[c, selected]
+            cmax = float(rho.abs().max())
+            if np.isfinite(cmax) and cmax > corr_max:
+                worst = str(rho.abs().idxmax())
+                if canon[c] == canon[worst] and cmax >= dup_corr:
+                    kind = "sign_flip_of" if float(rho[worst]) < 0 else "duplicate_of"
+                    dropped[str(c)] = f"{kind}={worst} (|ρ|={cmax:.3f})"
+                else:
+                    dropped[str(c)] = f"corr>{corr_max} (max={cmax:.3f} vs {worst})"
+                continue
+        selected.append(c)
+    report["seed_selected"] = [str(c) for c in selected]
+
+    # —— 阶段 B：新因子（残差 IC 贪心，逐日对比当前已选集合）——
+    remaining = list(cand_pool)
+    while remaining and len(selected) < max(topk, 1):
+        # 每步按当前口径排序（残差 IC 依赖已选集合 → 必须重排）
+        if rank_by == "resid_ic":
+            scored = []
+            for c in remaining:
+                rm = _resid_metrics(c)
+                metrics[str(c)].update(rm)
+                scored.append((c, rm))
+            scored.sort(key=lambda kv: (-abs(kv[1]["resid_ic"]), -abs(metrics[str(kv[0])]["icir"])))
+            order_step = [c for c, _ in scored]
+        else:
+            order_step = sorted(
+                remaining,
+                key=lambda c: (-abs(metrics[str(c)]["rank_ic"]), -abs(metrics[str(c)]["icir"])),
+            )
+
+        picked = None
+        for c in order_step:
+            # B9 兜底窗口过滤（名中窗口 < min_window 交易日 → 剔除）
+            w = _window_from_name(str(c))
+            if min_window > 0 and w is not None and w < min_window:
+                dropped[str(c)] = f"window<{min_window}d (={w}d)"
+                continue
+            mm = metrics[str(c)]
+            # 原始 IC 门槛（保留，阈值默认 0 = 不拦）
+            if min_abs_ic > 0 and abs(mm["rank_ic"]) < min_abs_ic:
+                dropped[str(c)] = f"|RankIC|<{min_abs_ic} (={mm['rank_ic']:+.4f})"
+                continue
+            # 显著性：残差口径优先（B6），回落到原始 ICIR（旧口径）
+            if rank_by == "resid_ic" and resid_tstat_min > 0:
+                t = mm.get("resid_tstat", 0.0)
+                if t < resid_tstat_min:
+                    dropped[str(c)] = f"resid_t<{resid_tstat_min} (t={t}, 残差IC={mm.get('resid_ic', 0):+.4f})"
+                    continue
+            elif min_icir_tstat > 0 and mm["tstat"] < min_icir_tstat:
+                dropped[str(c)] = f"|ICIR|·√days<{min_icir_tstat} (t={mm['tstat']})"
+                continue
+            # B9：同族窗口上限
+            if family_window_max > 0 and selected:
+                fam = canon[c]
+                same = [s for s in selected if canon[s] == fam]
+                if len(same) >= family_window_max:
+                    dropped[str(c)] = f"family_window_cap({fam}={len(same)}≥{family_window_max}; 已选 {same})"
+                    continue
+            # B5/B7：与已选高相关 → 剪枝；同族极强相关（ρ≈-1 或 ≥dup_corr）单独标注
+            if selected:
+                rho = corr.loc[c, selected]
+                cmax = float(rho.abs().max())
+                if np.isfinite(cmax) and cmax > corr_max:
+                    worst = str(rho.abs().idxmax())
+                    if canon[c] == canon[worst] and cmax >= dup_corr:
+                        kind = "sign_flip_of" if float(rho[worst]) < 0 else "duplicate_of"
+                        dropped[str(c)] = f"{kind}={worst} (|ρ|={cmax:.3f})"
+                    else:
+                        dropped[str(c)] = f"corr>{corr_max} (max={cmax:.3f} vs {worst})"
+                    continue
+            picked = c
+            break
+
+        if picked is None:
+            break
+        selected.append(picked)
+        remaining.remove(picked)
+
+    if not selected:  # 兜底：至少留一个
+        fallback = sorted(cols, key=lambda c: -abs(metrics[str(c)]["rank_ic"]))[0]
+        selected = [fallback]
+        dropped.pop(str(fallback), None)
+
+    # 4) B8：新因子（不在库里的）对库做截面正交化 —— 系数在抽样面板估计，分块应用到全面板
+    ortho_info: dict = {"enabled": bool(orthogonalize), "applied": []}
+    out = pool.loc[:, [c for c in cols if c in set(selected)]]
+    if orthogonalize and len(out.columns) > 1:
+        try:
+            out, ortho_info = _apply_orthogonalization(
+                out,
+                order=selected,
+                beta_fn=lambda c, s: _fit_beta(Z, c, s),
+                # 只对**新因子**正交化（库成员保持原值，不改动既有 SOTA 口径）
+                protect=set(cols[: max(int(sota_n), 0)]),
+            )
+        except Exception as e:  # 正交化失败 → 退回未正交化的选中集合
+            logger.warning(f"[factor-select] 正交化失败，回落未正交化集合：{type(e).__name__}: {e}")
+            ortho_info = {"enabled": True, "error": f"{type(e).__name__}: {e}"}
+            out = pool.loc[:, [c for c in cols if c in set(selected)]]
+
+    sel_set = set(selected)
+    final = [c for c in cols if c in sel_set]  # 保持原列序，减少下游抖动
+    report["selected"] = [str(c) for c in final]
+    report["dropped"] = dropped
+    report["kept_order"] = [str(c) for c in selected]
+    report["canonical"] = {str(c): canon[c] for c in final}
+    report["orthogonalized"] = ortho_info
+    # B8 代价补偿：把「正交化前的原始值」随返回值带出（同一索引、同一列序），
+    # 由 select_combined_factors 落盘为 combined_factors_raw.parquet + 正交化清单。
+    raw_final = pool.loc[:, final]
+    residual_cols = [str(a["factor"]) for a in ortho_info.get("applied", []) if "beta" in a]
+    report["residual_columns"] = residual_cols
+    res = _reorder_with_values(raw_final, out, final)
+    # ⚠️ attrs 是「带出通道」，不是可落盘的数据：pandas 的 to_parquet 会把 df.attrs
+    # 序列化成 parquet 元数据 PANDAS_ATTRS，DataFrame 无法 JSON 序列化 → 下游
+    # combined_factors.to_parquet() 会直接抛 TypeError。select_combined_factors
+    # 落完旁路文件后必须调 _strip_parquet_attrs() 清掉（2026-09-25 踩过）。
+    res.attrs["raw_values"] = raw_final
+    res.attrs["residual_columns"] = residual_cols
+    return res, report
+
+
+# 挂在 DataFrame.attrs 上、但**不可**进 parquet 元数据的键（含 DataFrame，无法 JSON 化）
+_PARQUET_UNSAFE_ATTRS = ("raw_values", "residual_columns")
+
+
+def _strip_parquet_attrs(df: pd.DataFrame) -> pd.DataFrame:
+    """清掉 attrs 里不可 JSON 序列化的键，避免 to_parquet 在 PANDAS_ATTRS 处报错。"""
+    try:
+        for k in _PARQUET_UNSAFE_ATTRS:
+            df.attrs.pop(k, None)
+    except Exception:
+        pass
+    return df
+
+
+def _reorder_with_values(base: pd.DataFrame, values: pd.DataFrame, final: list) -> pd.DataFrame:
+    """按 final 顺序返回 values（正交化后的值）；缺列则由 base 兜底。"""
+    cols = []
+    for c in final:
+        if c in values.columns:
+            cols.append(values[c])
+        else:
+            cols.append(base[c])
+    res = pd.concat(cols, axis=1)
+    res.columns = final
+    return res
+
+
+def _apply_orthogonalization(
+    combined: pd.DataFrame, *, order: list, beta_fn, protect: set | None = None
+) -> tuple[pd.DataFrame, dict]:
+    """把 `order` 里第 2 个起的**新因子**对**它之前的因子**做截面正交化（B8）。
+
+    protect：不参与正交化的列（SOTA 库成员，保持既有口径不变）。
+
+    做法：逐日截面 z-score → 用**抽样面板估计**的系数 β → 分块减 X·β（全面板应用）。
+    只用当日截面信息（β 是全局估计、不是未来数据），符合防未来函数纪律。
+    返回 (正交化后的同形 DataFrame, 说明)。
+    """
+    info: dict = {"enabled": True, "applied": [], "note": "残差按逐日截面 z-score 空间计算"}
+    cols = list(combined.columns)
+    betas: dict[str, np.ndarray] = {}
+    protect = protect or set()
+    for i, c in enumerate(order):
+        if c not in cols or i == 0 or c in protect:
+            continue
+        sels = [s for s in order[:i] if s in cols]
+        if not sels:
+            continue
+        b = beta_fn(c, sels)
+        if b is None:
+            info["applied"].append({"factor": str(c), "skipped": "insufficient_overlap"})
+            continue
+        betas[c] = (sels, b)
+
+    if not betas:
+        info["note"] += "；无可正交化项"
+        return combined, info
+
+    # 分块应用：逐日 z-score 后减 X·β
+    out = combined.copy()
+    dates = combined.index.get_level_values("datetime")
+    uniq = dates.unique()
+    chunk = 200
+    for i0 in range(0, len(uniq), chunk):
+        part = uniq[i0 : i0 + chunk]
+        mask = np.isin(dates.values, part)
+        blk = out.loc[mask]
+        zb = _zscore_by_day(blk)
+        for c, (sels, b) in betas.items():
+            X = zb[sels].to_numpy(dtype=np.float64)
+            r = zb[c].to_numpy(dtype=np.float64) - X @ b
+            out.loc[blk.index, c] = r.astype(combined[c].dtype, copy=False)
+    info["applied"] = [
+        {"factor": str(c), "against": [str(s) for s in sels], "beta": [round(float(x), 6) for x in b]}
+        for c, (sels, b) in betas.items()
+    ]
+    return out, info
+
+
+def _dump_raw_and_manifest(
+    out: pd.DataFrame, report: dict, workspace: Path, *, sota_n: int = 0
+) -> None:
+    """B8 代价补偿：正交化后写进 parquet 的是**残差** → 另存一份**原始值** + 正交化**清单**。
+
+    - `combined_factors_raw.parquet`：选中列的正交化前原始值（与主 parquet 同索引、同列序）
+    - `factor_ortho_manifest.json`：哪些列被正交化 / 对谁 / β / 当时配置
+
+    未发生正交化（或拿不到原始值）则**两个文件都不写**，避免产生误导性的空清单。
+    任何异常只 warning，不影响主流程（降级安全）。
+    """
+    applied = [
+        a
+        for a in ((report.get("orthogonalized") or {}).get("applied") or [])
+        if isinstance(a, dict) and "beta" in a

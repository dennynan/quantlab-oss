+            int(getattr(setting, "factor_select_family_window_max", DEFAULT_FAMILY_WINDOW_MAX)),
+        ),
+        dup_corr=_env_override(
+            "RDAGENT_FACTOR_DUP_CORR",
+            float(getattr(setting, "factor_select_dup_corr", DEFAULT_DUP_CORR)),
+        ),
+        sota_n=int(sota_n or 0),
+        source_path=getattr(setting, "factor_select_source_path", None),
+        close_col=str(getattr(setting, "factor_select_close_col", DEFAULT_CLOSE_COL)),
+    )
+    report: dict = {"enabled": True, "ok": False}
+    try:
+        out, rep = select_factors(combined, **kwargs)
+        report.update(rep)
+        report["ok"] = True
+    except Exception as e:  # 降级：任何异常都不该打断 loop
+        report["error"] = f"{type(e).__name__}: {e}"

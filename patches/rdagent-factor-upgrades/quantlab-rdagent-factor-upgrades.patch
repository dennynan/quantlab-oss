+"""重试升温（retry temperature boost）。
+
+背景（2026-10-09）：
+`LLMHypothesis2Experiment.convert` 上的 `@wait_retry(retry_n=5)` 是用**完全相同的
+prompt** 重跑（没有 feedback、没有 transform_args_fn）。当提案因「与历史重复 / 回看窗口
+过短」被拒时，低温度（chat_temperature=0.2）下 LLM 会近乎确定性地复读同一个名字，
+连续 6 次撞同一堵墙 → 空圈跳圈 → 零产物（见 rd_20261009_181951 / Loop 41 Skip）。
+
+这里提供一个**线程级**（RD-Agent 的调用链是同步的，同线程）临时温度增量：
+重试前 set，重试结束/成功返回时 clear；LLM 后端在拼请求参数时把增量加到
+chat_temperature 上，让第 2 次起的采样真正发散。
+
+不发散时（默认 delta=0）行为与改造前完全一致。
+"""
+
+from __future__ import annotations
+
+import threading
+
+_local = threading.local()
+
+
+def set_retry_temperature_boost(delta: float) -> None:
+    """给当前线程设置 chat_temperature 增量（正数=升温；<=0 等价于清除）。"""
+    value = float(delta)
+    if value <= 0:
+        clear_retry_temperature_boost()
+        return
+    _local.delta = value
+
+
+def clear_retry_temperature_boost() -> None:
+    """清除当前线程的温度增量。
+
+    必须在重试链结束（成功返回或最终抛错）时调用，避免增量泄漏到后续无关的 LLM 请求。
+    """
+    if hasattr(_local, "delta"):
+        del _local.delta
+
+
+def get_retry_temperature_boost() -> float:
+    """读取当前线程的温度增量，默认 0.0。"""
+    return float(getattr(_local, "delta", 0.0) or 0.0)

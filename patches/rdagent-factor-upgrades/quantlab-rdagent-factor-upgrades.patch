index 0000000..3b5ee09
--- /dev/null
+++ b/rdagent/scenarios/qlib/developer/stagnation_restart.py
@@ -0,0 +1,199 @@
+"""停滞自动重启（B6）
+
+背景（2026-09-19 定位）
+-----------------------
+Replace Best 是一把**棘轮**：只有当新组合的 Calmar 赢过 SOTA、且回撤不劣化（>3pp）时
+才允许替换基线。连续多轮 no-replace 之后，LLM 的提案会退化成对 SOTA 的局部变体
+（实测：`roe_trend_filter` → `roe_trend_filter_100d`、`reversal_5d_vol_scaled` → `..._20d`），
+loop 卡死在局部最优 —— 2026-09-12 09:50 ~ 09-16 08:30 连续约 20 次运行 `active_factors`
+一个字没变。
+
+B4/B5（factor_selector）解决了「因子池只增不减、弱因子永久占位」，
+但棘轮本身还在：新组合只要在同一批老因子上加料，就很难同时赢 Calmar + 不劣化回撤。
+
+本模块（B6）提供**停滞自动重启**：连续 `patience` 轮 Replace Best=no ⇒ 清空 SOTA 基线，
+让 loop 回到「首轮语义」重新出发。
+
+机制（为什么清空 decision 就够了）
+----------------------------------
+`Trace.get_sota_hypothesis_and_experiment()` 逆序遍历 `hist`，返回**最后一个
+`feedback.decision is True`** 的实验 —— SOTA 完全由 decision 标记决定。因此：
+
+1. 把 hist 里所有 `feedback.decision` 置 False ⇒ `get_sota_*()` 返回 None ⇒
+   回测反馈没有对比基线、不再被棘轮卡住；
+2. `ExperimentFeedback.__bool__` 返回 `decision`，而提案侧
+   `exp.based_experiments = [dummy] + [t[0] for t in trace.hist if t[1] and ...]`
+   ⇒ 因子池同时被清空（等价于首轮），真正做到「重开」；
+3. 下一轮只要 Replace Best=yes，就立刻建立**新基线**（棘轮归零后重新开始爬）。
+
+⚠️ 第 2 点的下一轮与「loop 0」代码路径完全一致（`based_experiments=[dummy]`、无 SOTA），
+该路径每次运行都会跑，已被真实验证安全。
+
+防抖
+----
+重启后 hist 尾部全是 False，若不记状态会每轮重复触发。故在 trace 上记录
+`_stagnation_restart_at`（重启时的 hist 长度）与 `_stagnation_restart_count`；
+要求「距上次重启至少 `patience` 轮」才再次触发。Trace 是普通 Python 类，属性随
+session pickle 一起持久化，续跑不丢。
+
+安全
+----
+任何异常一律 warning 跳过，不打断 loop。关闭：env `RDAGENT_FACTOR_RESTART=0`。
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any
+
+from rdagent.log import rdagent_logger as logger
+
+DEFAULT_ENABLE = False
+# 2026-09-20：默认关闭。
+# 原因：清空 decision 会把 Replace 判定基线从「会话最优」退化成「种子基线」，
+# 首个真实停滞场景（rd_20260920_151207 / Loop_8）就把 0.525 的最优组合覆盖成 0.102。
+# 判定基线已改为「会话历史最优」（见 developer/feedback.py historical_best_result），
+# 但重启本身在真实场景仍未验证，默认 OFF；显式打开用 RDAGENT_FACTOR_RESTART=1。
+DEFAULT_PATIENCE = 3
+
+# env 开关，临时关掉用 RDAGENT_FACTOR_RESTART=0
+_ENV_SWITCH = "RDAGENT_FACTOR_RESTART"
+_FALSEY = {"0", "false", "False", "no", "off", ""}
+
+_ATTR_AT = "_stagnation_restart_at"
+_ATTR_COUNT = "_stagnation_restart_count"
+
+
+# ---------------------------------------------------------------------------
+# 配置
+# ---------------------------------------------------------------------------
+def _load_setting() -> Any:
+    """读取 FactorBasePropSetting（读不到就返回 None，走默认值）。"""
+    try:
+        from rdagent.app.qlib_rd_loop.conf import FactorBasePropSetting
+
+        return FactorBasePropSetting()
+    except Exception:  # pragma: no cover - 配置缺失时保持可用
+        return None
+
+
+def _env_disabled() -> bool:
+    """`RDAGENT_FACTOR_RESTART=0/False/no/off` 时强制关闭（与 factor_selector 的开关风格一致）。
+
+    注意：不能只靠 setting 属性 —— `FactorBasePropSetting` 的 env_prefix 是 `QLIB_FACTOR_`，
+    对应的环境变量名会是 `QLIB_FACTOR_FACTOR_RESTART_ENABLE`，与文档里承诺的
+    `RDAGENT_FACTOR_RESTART` 不是同一个，故这里显式读 os.environ。
+    """
+    return os.environ.get(_ENV_SWITCH, "1").strip() in _FALSEY
+
+
+def _resolve(enable: bool | None, patience: int | None) -> tuple[bool, int]:
+    setting = _load_setting()
+    if enable is None:
+        if _env_disabled():
+            enable = False
+        else:
+            enable = (
+                getattr(setting, "factor_restart_enable", DEFAULT_ENABLE)
+                if setting
+                else DEFAULT_ENABLE
+            )
+            if str(enable).strip() in _FALSEY:
+                enable = False
+    if patience is None:
+        patience = (
+            int(getattr(setting, "factor_restart_patience", DEFAULT_PATIENCE))
+            if setting
+            else DEFAULT_PATIENCE
+        )
+    return bool(enable), max(1, int(patience))
+
+
+# ---------------------------------------------------------------------------
+# 核心
+# ---------------------------------------------------------------------------
+def _feedback_of(item: Any) -> Any:
+    """hist 条目是 (exp, feedback) 元组；兼容不带 feedback 的写法。"""
+    if isinstance(item, (tuple, list)):
+        return item[1] if len(item) > 1 else None
+    return getattr(item, "feedback", None)
+
+
+def consecutive_no_replace(trace: Any) -> int:
+    """统计 hist 尾部连续 Replace Best=no 的轮数（遇到 decision=True 即止）。"""
+    hist = getattr(trace, "hist", None) or []
+    n = 0
+    for item in reversed(hist):
+        fb = _feedback_of(item)
+        if fb is None:
+            continue
+        if getattr(fb, "decision", False):
+            break
+        n += 1
+    return n
+
+
+def clear_sota_decisions(trace: Any) -> int:
+    """把所有历史 feedback.decision 置 False ⇒ SOTA 与因子池一起回到首轮状态。"""
+    cleared = 0
+    for item in getattr(trace, "hist", None) or []:
+        fb = _feedback_of(item)
+        if fb is not None and getattr(fb, "decision", False):
+            fb.decision = False
+            cleared += 1
+    return cleared
+
+
+def maybe_restart_on_stagnation(
+    trace: Any,
+    *,
+    enable: bool | None = None,
+    patience: int | None = None,
+    loop_idx: int | None = None,
+) -> dict | None:
+    """停机检测 + 重启入口。返回本次动作报告；未触发返回 None。"""
+    enable, patience = _resolve(enable, patience)
+    if not enable:
+        return None
+
+    n_stall = consecutive_no_replace(trace)
+    if n_stall < patience:
+        return None
+
+    hist_len = len(getattr(trace, "hist", None) or [])
+    last_at = int(getattr(trace, _ATTR_AT, 0) or 0)
+    if hist_len - last_at < patience:
+        # 距上次重启不足 patience 轮，防抖：不重复清空
+        return None
+
+    prev_count = int(getattr(trace, _ATTR_COUNT, 0) or 0)
+    cleared = clear_sota_decisions(trace)
+    report = {
+        "event": "stagnation_restart",
+        "loop_idx": loop_idx,
+        "stagnation_rounds": n_stall,
+        "patience": patience,
+        "cleared_decisions": cleared,
+        "hist_len_at_restart": hist_len,
+        "restart_count": prev_count + 1,
+        "action": "清空全部 Replace Best=yes 标记 ⇒ SOTA 基线与因子池回到首轮语义，下一轮重新建立新基线",
+    }
+
+    # 状态写回 trace（随 session pickle 持久化），放在动作之后，避免异常导致状态漂移
+    try:
+        setattr(trace, _ATTR_AT, hist_len)
+        setattr(trace, _ATTR_COUNT, prev_count + 1)
+    except Exception as e:  # pragma: no cover
+        logger.warning(f"[stagnation-restart] 状态写回失败（忽略）：{e}")
+
+    try:
+        logger.log_object(report, tag="stagnation restart report")
+    except Exception as e:  # pragma: no cover - 日志失败不影响主流程
+        logger.warning(f"[stagnation-restart] 报告落盘失败（忽略）：{e}")
+
+    logger.info(
+        f"[stagnation-restart] 连续 {n_stall} 轮 Replace Best=no（阈值 {patience}）"

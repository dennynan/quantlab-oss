+      3) 规范键（同义词表：`ILLIQ_20D` == `amihud_illiquidity_20d`）；读不出窗口时按家族兜底
+    另外拦「本轮内自我重复」。返回 (保留的 tasks, 被剔除的 [(因子名, 原因)])。
+
+    注意：本层只看**本会话**历史。跨会话历史不在此层（L2 需理由 / L3 台账驱动，待实施）。
+    """
+    hist_keys = {normalize_factor_key(n) for n in hist_names}
+    hist_canon = {canonical_dedup_key(n) for n in hist_names}
+    hist_canon_fams = {canonical_family_key(n) for n in hist_names}
+    unique_tasks: List[FactorTask] = []
+    dropped: List[tuple] = []
+    seen_keys: set = set()
+    seen_canon: set = set()
+    for task in tasks:
+        norm_key = normalize_factor_key(task.factor_name)
+        windows = extract_factor_windows(task)
+        canon = canonical_dedup_key(task.factor_name, windows)
+        canon_fam = canonical_family_key(task.factor_name)
+        if task.factor_name in hist_names:
+            dropped.append((task.factor_name, "精确同名（本会话已挖过）"))
+            continue
+        if norm_key in hist_keys:
+            dropped.append((task.factor_name, f"换皮重复（规范化键 {norm_key} 已在本会话用过）"))
+            continue
+        if canon in hist_canon:
+            dropped.append((task.factor_name, f"同义重复（规范键 {canon} 已在本会话用过）"))
+            continue
+        if not windows and canon_fam in hist_canon_fams:
+            dropped.append((task.factor_name, f"同家族无窗口兜底（家族 {canon_fam} 已在本会话探索过）"))
+            continue
+        if norm_key in seen_keys or canon in seen_canon:
+            dropped.append((task.factor_name, f"本轮内重复（规范键 {canon}）"))
+            continue
+        seen_keys.add(norm_key)
+        seen_canon.add(canon)
+        unique_tasks.append(task)
+    for name, why in dropped:
+        logger.info(f"[factor-dedup] 剔除 {name}：{why}")
+    return unique_tasks, dropped
+
+
+def filter_by_min_window(tasks: List[FactorTask], min_window: int) -> Tuple[List[FactorTask], List[tuple]]:
+    """剔除回看窗口 < min_window 交易日的因子。返回 (保留列表, 被剔除的 (因子名, 窗口) 列表)。
+
+    只否决「能明确读出窗口且过短」的因子；读不出窗口的一律放行，避免误杀。
+    """
+    if min_window <= 0:
+        return list(tasks), []
+    kept: List[FactorTask] = []
+    rejected: List[tuple] = []
+    for t in tasks:
+        ws = extract_factor_windows(t)
+        if ws and min(ws) < min_window:
+            rejected.append((t.factor_name, ws))
+        else:
+            kept.append(t)
+    return kept, rejected
+
+
+def normalize_factor_key(name: str) -> str:
+    """把因子名规范化成「同族同窗」键：剥掉换皮修饰后缀/版本号 + 统一小写。
+
+    pv_corr_20d / pv_corr_20d_v2 / pv_corr_20d_filtered → pv_corr_20d
+    注意：窗口不同的仍是不同的键（pv_corr_10d != pv_corr_20d）；跨窗口的「同族」避重
+    走 prompt 引导，不在这里硬砍，避免把合理的窗口探索也一并封死。
+    """
+    k = str(name or "").strip().lower()
+    prev = None
+    while prev != k:  # 连续后缀一次剥干净（如 xxx_20d_v2_filtered）
+        prev = k
+        k = _DECOR_SUFFIX_RE.sub("", k)
+    return re.sub(r"_+", "_", k).strip("_")
+
+
+def factor_family_key(name: str) -> str:
+    """因子「家族」键 = 规范化键去掉窗口 token（用于提示词里汇总已探索家族）。
+
+    pv_corr_20d / pv_corr_10d → pv_corr；reversal_5d_vol_scaled → reversal_vol_scaled。
+    ⚠️ 只做「字面」归一（去窗口/去装饰后缀），不做同义词归并 —— 需要同义词口径
+    请用 `canonical_family_key()`。
+    """
+    k = normalize_factor_key(name)
+    k = _WINDOW_IN_NAME.sub("", k)
+    k = re.sub(r"(\d{1,4})\s*(?:d(?:ays?)?)(?![a-z0-9])", "", k, flags=re.IGNORECASE)
+    return re.sub(r"_+", "_", k).strip("_")
+
+
+# ===========================================================================
+# 因子同义词表（2026-09-24，P0-3 根治）
+# ---------------------------------------------------------------------------
+# 问题：`factor_family_key` 只比字面。LLM 只要换个叫法，同一个因子就能再挖一遍：
+#   历史 ILLIQ_20D      → 本轮 amihud_illiquidity_20d
+#   历史 DOWNBETA_60D   → 本轮 downside_beta_60d
+#   历史 MOM_5D         → 本轮 momentum_5d / price_momentum_5d
+# 解法：把「同一概念的不同写法（缩写/全称/历史大写/同族拼写）」归到一个规范家族。
+#
+# 规则用 `re.fullmatch` 整串匹配（越具体越靠前），不匹配就退回「逐 token 别名」。
+# 新增别名时只改这一张表即可（配置化，不散落在逻辑里）。
+# ===========================================================================
+_FAMILY_ALIAS_RULES: tuple[tuple[str, str], ...] = (
+    # 流动性：Amihud 非流动性
+    (r"(?:amihud_?)?(?:illiq|illiquidity)(?:_?ratio)?", "illiq"),
+    # 波动率：vol / volatility / realized_vol / realized_volatility / rv / std / sigma
+    (r"(?:realized_?|real_?)?(?:vol|volatility)|rv|std(?:_dev(?:iation)?)?|sigma", "volatility"),
+    # 动量（注意 fullmatch：volume_weighted_momentum 不会被归到这里）
+    (r"(?:price_?|ret(?:urn)?_?)?(?:mom|momentum)", "momentum"),
+    # 反转（含 mean reversion）
+    (r"(?:mean_?)?(?:rev|reversal|reversion|mean_?reversal)", "reversal"),
+    # 收盘位置（CLV）
+    (r"clv|close_?loc(?:ation)?(?:_value)?", "clv"),
+    (r"skew(?:ness)?", "skew"),
+    (r"kurt(?:osis)?", "kurt"),
+    # 价量相关（pv_corr / return_volume_corr / price_volume_corr / corr_pv ...）
+    (r"(?:pv|price_?vol(?:ume)?|ret(?:urn)?_?vol(?:ume)?)_?corr(?:elation)?", "pv_corr"),
+    (r"corr_?(?:pv|price_?vol(?:ume)?|ret(?:urn)?_?vol(?:ume)?)", "pv_corr"),
+    # 量比 / 换手
+    (r"vol(?:ume)?_?ratio|volratio|turnover_?ratio", "vol_ratio"),
+    (r"turnover(?:_rate)?|turn", "turnover"),
+    # 量价趋势（VPT / PVT 同一回事：Price-Volume Trend）——注意 divergence 是另一个家族，不会命中
+    (r"pvt|vpt|volume_?price_?trend|price_?volume_?trend", "vpt"),
+    # VWAP 偏离（vwap_dev / vwap_deviation / vwap_deviation_ratio 同一回事）
+    (r"vwap_?(?:dev|deviation|deviat(?:ion)?_?ratio)(?:_?ratio)?", "vwap_dev"),
+    # 下行相关系数 / 下行 beta（历史大写 DOWNBETA / DOWNCORR）
+    (r"down(?:corr|side_?corr(?:elation)?)", "downcorr"),
+    (r"down(?:beta|side_?beta)", "downside_beta"),
+    # 波动缩放反转（reversal_vol_scaled / volatility_scaled_reversal 同一东西）
+    (r"(?:vol(?:atility)?_?scaled_?reversal|reversal_?vol(?:atility)?_?scaled)", "vol_scaled_reversal"),
+    # 价量背离（volume_price_divergence / price_volume_trend_divergence 同一概念）
+    (r"(?:pv|price_?volume|volume_?price)_?(?:trend_?)?divergence", "pv_divergence"),
+    # 成交额
+    (r"amt|amount|dollar_?volume", "amount"),
+)
+_FAMILY_ALIAS_COMPILED: tuple[tuple[re.Pattern, str], ...] = tuple(
+    (re.compile(rf"^(?:{pat})$", re.IGNORECASE), canon) for pat, canon in _FAMILY_ALIAS_RULES
+)
+
+# 逐 token 别名（整串规则不命中时用；只做精确 token 替换，不做子串替换，避免误伤）
+_FAMILY_TOKEN_ALIAS: dict[str, str] = {
+    "illiq": "illiq",
+    "illiquidity": "illiq",
+    "vol": "volatility",
+    "realized_vol": "volatility",
+    "ret": "return",
+    "mom": "momentum",
+    "rev": "reversal",
+    "skewness": "skew",
+    "kurtosis": "kurt",
+}
+
+
+def canonical_family_key(name: str) -> str:
+    """因子「规范家族」键（含同义词归并）。
+
+    ILLIQ_20D / amihud_illiq_5d / amihud_illiquidity_20d  → illiq
+    DOWNBETA_60D / downside_beta_20d                      → downside_beta
+    reversal_10d_vol_scaled_60d / volatility_scaled_reversal_5d → vol_scaled_reversal
+
+    先整串匹配同义词规则；不命中则逐 token 归一后拼回。这是去重与「家族清单」的统一口径。
+    """
+    k = factor_family_key(name)
+    if not k:
+        return k
+    for rx, canon in _FAMILY_ALIAS_COMPILED:
+        if rx.match(k):
+            return canon
+    toks = [_FAMILY_TOKEN_ALIAS.get(t, t) for t in k.split("_")]
+    return "_".join(t for t in toks if t)
+
+
+def windows_from_name(name: str) -> List[int]:
+    """从因子名里读回看窗口（无窗口返回 []）。用于历史因子名（拿不到 FactorTask 时）。"""
+    return sorted({int(m) for m in _WINDOW_IN_NAME.findall(str(name or ""))})
+
+
+def canonical_dedup_key(name: str, windows: Optional[List[int]] = None) -> str:
+    """跨命名去重键 = 规范家族 + 窗口集合。
+
+    amihud_illiquidity_20d 与 历史 ILLIQ_20D  → 同为 "illiq@20"，命中拦截；
+    而 illiq_60d → "illiq@60"，仍算窗口探索，放行（与 factor_proposal 既有窗口策略一致）。
+    """
+    ws = windows_from_name(name) if windows is None else windows
+    ws = sorted({int(w) for w in ws})
+    return f"{canonical_family_key(name)}@{','.join(str(w) for w in ws)}"
+
 

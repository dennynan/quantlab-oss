+def calmar_with_cost(result) -> float | None:
+    """从回测 result 里算含成本 Calmar（年化收益 / |最大回撤|）；取不到返回 None。"""
+    if result is None:
+        return None
+    try:
+        ann = float(result["1day.excess_return_with_cost.annualized_return"])
+        mdd = float(result["1day.excess_return_with_cost.max_drawdown"])
+    except Exception:
+        return None
+    if not mdd:
+        return None
+    c = ann / abs(mdd)
+    if c != c:  # NaN 保护
+        return None
+    return c
+

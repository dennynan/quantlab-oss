+
+    if workspace is not None:
+        try:
+            report["effective_columns"] = [str(c) for c in out.columns]
+            (Path(workspace) / "factor_selection_report.json").write_text(
+                json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8"
+            )
+        except Exception as e:
+            logger.warning(f"[factor-select] 报告写入失败：{e}")
+        # B8 代价补偿：另存原始值 + 正交化清单（未正交化则跳过）
+        _dump_raw_and_manifest(out, report, Path(workspace), sota_n=int(sota_n or 0))
+    # 旁路文件已落盘 → 清掉不可序列化的 attrs，保证下游 to_parquet 正常
+    # （pandas 会 json.dumps(df.attrs) 写 PANDAS_ATTRS，DataFrame 会直接炸）
+    return _strip_parquet_attrs(out)

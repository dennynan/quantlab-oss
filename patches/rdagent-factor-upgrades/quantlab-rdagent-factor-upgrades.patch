+        raw.to_parquet(Path(workspace) / "combined_factors_raw.parquet", engine="pyarrow")
+        residual_cols = [str(a["factor"]) for a in applied]
+        residual_set = set(residual_cols)
+        manifest = {
+            "generated_at": pd.Timestamp.now().isoformat(timespec="seconds"),
+            "note": (
+                "combined_factors_df.parquet 中 residual_columns 那几列是【残差】（对当时库正交化后），"
+                "不是因子原义；原始值见 combined_factors_raw.parquet（同索引、同列序）。"

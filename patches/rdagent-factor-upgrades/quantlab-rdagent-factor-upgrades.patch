+def historical_best_result(trace):
+    """返回会话历史最优实验（按含成本 Calmar）的 result。
+
+    2026-09-20 修复（棘轮基线退化）：
+    原判定基线是 `exp.based_experiments[-1].result`，而 based_experiments 只收
+    `feedback.decision is True` 的实验 —— 一旦上游停滞重启（B6）清空 decision 标记，
+    based_experiments 会退化成 [种子基线]，基线 Calmar 从会话最优 0.525 掉到 0.094，
+    劣质组合（0.102）就能被判 Replace Best=yes 覆盖掉最优（rd_20260920_151207）。
+    这里改为遍历 trace.hist 全量实验（**不看 decision**），取 Calmar 最高者作基线，
+    这样清空标记 / 重启都不会再动到棘轮基线。
+    """
+    best_result, best_calmar = None, None
+    for item in getattr(trace, "hist", None) or []:
+        exp = item[0] if isinstance(item, (tuple, list)) and len(item) > 0 else item
+        r = getattr(exp, "result", None)
+        if r is None:
+            continue
+        c = calmar_with_cost(r)
+        if c is None:
+            continue
+        if best_calmar is None or c > best_calmar:
+            best_result, best_calmar = r, c
+    return best_result
+
+
+def ratchet_guard(decision: bool, current_result, sota_result) -> bool:
+    """棘轮硬闸（只降不升）：当前 Calmar 未超过基线时，禁止 Replace Best=yes。
+
+    防止 LLM 在边界情形下误判；仅在能同时取到两个 Calmar 时生效，且只会把 yes 降成 no。
+    """
+    if not decision:
+        return False
+    cur = calmar_with_cost(current_result)
+    base = calmar_with_cost(sota_result)
+    if cur is None or base is None:
+        return decision
+    if cur <= base:
+        logger.warning(
+            f"[ratchet] 本轮 Calmar {cur:.6f} 未超过基线 {base:.6f}，强制 Replace Best=no"
+        )
+        return False
+    return True
+
